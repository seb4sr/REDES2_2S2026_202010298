<NAME>http:</NAME>\n      <DATE_TIME>0</DATE_TIME>\n      <PERMISSION>6</PERMISSION>\n      <FILE_CONTENT/>\n      <FILES>\n       <FILE class="CFile">\n        <FILE_NUMBER>4</FILE_NUMBER>\n        <NAME>copyrights.html</NAME>\n        <DATE_TIME>0</DATE_TIME>\n        <PERMISSION>6</PERMISSION>\n        <FILE_CONTENT class="CHttpPage">\n         <TEXT>&lt;html>DOWNLOADING, INSTALLING, OR USING THE CISCO PACKET TRACER SOFTWARE CONSTITUTES ACCEPTANCE OF THE CISCO END USER LICENSE AGREEMENT("EULA" https://www.cisco.com/c/en/us/about/legal/cloud-and-software/end_user_license_agreement.html) AND THE SUPPLEMENTAL END USER LICENSE AGREEMENT FOR CISCO PACKET TRACER ("SEULA" https://www.cisco.com/c/dam/en_us/about/doing_business/legal/seula/cisco-packet-tracer-software.pdf). IF YOU DO NOT AGREE TO ALL OF THE TERMS OF THE EULA AND SEULA, THEN CISCO SYSTEMS, INC. ("CISCO") IS UNWILLING TO LICENSE THE SOFTWARE TO YOU AND YOU ARE NOT AUTHORIZED TO DOWNLOAD, INSTALL OR USE THE SOFTWARE.&lt;/html>\n</TEXT>\n        </FILE_CONTENT>\n       </FILE>\n       <FILE class="CFile">\n        <FILE_NUMBER>5</FILE_NUMBER>\n        <NAME>cscoptlogo177x111.jpg</NAME>\n        <DATE_TIME>0</DATE_TIME>\n        <PERMISSION>6</PERMISSION>\n        <FILE_CONTENT class="CHttpPage">\n         <TEXT></TEXT>\n        </FILE_CONTENT>\n       </FILE>\n       <FILE class="CFile">\n        <FILE_NUMBER>3</FILE_NUMBER>\n        <NAME>helloworld.html</NAME>\n        <DATE_TIME>0</DATE_TIME>\n        <PERMISSION>6</PERMISSION>\n        <FILE_CONTENT class="CHttpPage">\n         <TEXT>&lt;html>\nHello, world!\n&lt;br>&lt;a href=\'index.html\'>Back&lt;/a>\n&lt;/html></TEXT>\n        </FILE_CONTENT>\n       </FILE>\n       <FILE class="CFile">\n        <FILE_NUMBER>2</FILE_NUMBER>\n        <NAME>image.html</NAME>\n        <DATE_TIME>0</DATE_TIME>\n        <PERMISSION>6</PERMISSION>\n        <FILE_CONTENT class="CHttpPage">\n         <TEXT>&lt;html>\n&lt;body>\n&lt;center>&lt;font size=\'+2\' color=\'blue\'>Image of Cisco Logo&lt;/font>&lt;/center>\n&lt;p>This is an image of Cisco Logo&lt;/p>\n&lt;p>&lt;a href=\'cscoptlogo177x111.jpg\'>&lt;img src="/cscoptlogo177x111.jpg"/>&lt;/a>&lt;/p>\n&lt;br>&lt;a href=\'index.html\'>Back&lt;/a>\n&lt;/body>\n&lt;/html></TEXT>\n        </FILE_CONTENT>\n       </FILE>\n       <FILE class="CFile">\n        <FILE_NUMBER>1</FILE_NUMBER>\n        <NAME>index.html</NAME>\n        <DATE_TIME>0</DATE_TIME>\n        <PERMISSION>6</PERMISSION>\n        <FILE_CONTENT class="CHttpPage">\n         <TEXT>&lt;html>\n&lt;center>&lt;font size=\'+2\' color=\'blue\'>Cisco Packet Tracer&lt;/font>&lt;/center>\n&lt;hr>Welcome to Cisco Packet Tracer. Opening doors to new opportunities. Mind Wide Open.\n&lt;p>Quick Links:\n&lt;br>&lt;a href=\'helloworld.html\'>A small page&lt;/a>\n&lt;br>&lt;a href=\'copyrights.html\'>Copyrights&lt;/a>\n&lt;br>&lt;a href=\'image.html\'>Image page&lt;/a>\n&lt;br>&lt;a href=\'cscoptlogo177x111.jpg\'>Image&lt;/a>\n&lt;/html></TEXT>\n        </FILE_CONTENT>\n       </FILE>\n      </FILES>\n      <FILE_COUNTER>5</FILE_COUNTER>\n      <CAPACITY>100000000</CAPACITY>\n     </FILE>\n     <FILE class="CFileSystem">\n      <FILE_NUMBER>0</FILE_NUMBER>\n      <NAME>ioe:</NAME>\n      <DATE_TIME>0</DATE_TIME>\n      <PERMISSION>6</PERMISSION>\n      <FILE_CONTENT/>\n      <FILES>\n       <FILE class="CFile">\n        <FILE_NUMBER>2</FILE_NUMBER>\n        <NAME>create_account.html</NAME>\n        <DATE_TIME>0</DATE_TIME>\n        <PERMISSION>14</PERMISSION>\n        <FILE_CONTENT class="CHttpPage">\n         <TEXT>&lt;html>\n&lt;head>\n&lt;script>\nfunction validateAccount(form)\n{\n  var userid = document.forms["createAccount"]["userid"].value;\n  var password = document.forms["createAccount"]["pw"].value;\n  if (userid.length == 0)\n  {\n    alert("Please enter the userid.");\n  }\n  else if (password.length == 0)\n  {\n    alert("Please enter the password.");\n  }\n  else\n  {\n    CHttpFormExtractor.submitIoeLogin(userid, password, function(rtn) { form.submit();});\n  }\n  return false;\n}\n&lt;/script>\n&lt;/head>\n&lt;body>\n&lt;center>\n&lt;h3>Registration Server Account Creation&lt;/h3>\n&lt;table>\n&lt;tr>&lt;td>\n&lt;form name="createAccount" method="post" action="account_action.php" onsubmit="return validateAccount(this)">\nUsername: &lt;input type="text" name="userid" id="userid" value="" size="20">&lt;br>\nPassword: &lt;input type="password" name="pw" id="pw" value="" size="20">&lt;br>\n&lt;br>\n&lt;center>\n&lt;input type="submit" value="Create">\n&lt;/center>\n&lt;/form>\n&lt;/td>&lt;/tr>\n&lt;/table>\n&lt;/center>\n&lt;/body>\n&lt;/html></TEXT>\n        </FILE_CONTENT>\n       </FILE>\n       <FILE class="CFile">\n        <FILE_NUMBER>1</FILE_NUMBER>\n        <NAME>index.php</NAME>\n        <DATE_TIME>0</DATE_TIME>\n        <PERMISSION>6</PERMISSION>\n        <FILE_CONTENT class="CHttpPage">\n         <TEXT>&lt;html>\n&lt;head>\n&lt;script>\nfunction validateLogin(form)\n{\n  var userid = document.forms["login"]["userid"].value;\n  var password = document.forms["login"]["pw"].value;\n  if (userid.length == 0)\n  {\n    alert("Please enter the userid.");\n  }\n  else if (password.length == 0)\n  {\n    alert("Please enter the password.");\n  }\n  else\n  {\n    CHttpFormExtractor.submitIoeLogin(userid, password, function(rtn) { form.submit();});\n  }\n  return false;\n}\n&lt;/script>\n&lt;/head>\n&lt;body>\n&lt;center>\n&lt;h3>Registration Server Login&lt;/h3>\n&lt;table>\n&lt;tr>&lt;td>\n&lt;form name="login" method="post" action="login_action.php" onsubmit="return validateLogin(this)">\nUsername: &lt;input type="text" name="userid" id="userid" value="" size="20">&lt;br>\nPassword: &lt;input type="password" name="pw" id="pw" value="" size="20">&lt;br>\n&lt;br>\n&lt;center>\n&lt;input type="submit" value="Sign In">\n&lt;/center>\n&lt;/form>\n&lt;/td>&lt;/tr>\n&lt;/table>\n&lt;/center>\n&lt;span>Don\'t have an IoT account?&lt;/span> &lt;a id="idA_SignUp" class="TextSemiBold" href="cre